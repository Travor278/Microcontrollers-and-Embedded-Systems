   3          /*
   4           * EX2 Advanced: Traffic light system with emergency vehicle priority
   5           *
   6           * The system is modeled as a time-driven finite state machine:
   7           *   1. NS green  / EW red
   8           *   2. NS yellow / EW red
   9           *   3. EW green  / NS red
  10           *   4. EW yellow / NS red
  11           *
  12           * Main loop:
  13           *   - Advances countdown using software seconds from Timer0
  14           *   - Switches to next state when current duration expires
  15           *   - On emergency request: saves context, switches to all-red mode
  16           *
  17           * Interrupts:
  18           *   - Timer0: stable time base (50 ms tick)
  19           *   - INT0:   sets emergency_req flag only; main loop does the rest
  20           */
  21          
  22          /*
  23           * Port assignment:
  24           * P1.0  NS red
  25           * P1.1  NS yellow
  26           * P1.2  NS green
  27           * P1.3  EW red
  28           * P1.4  EW yellow
  29           * P1.5  EW green
  30           *
  31           * INT0  Emergency request, low-level triggered.
  32           *       All-red for 10 s, then restore previous state.
  33           */
  34          
  35          #define NS_RED   0x01
  36          #define NS_YEL   0x02
  37          #define NS_GRN   0x04
  38          #define EW_RED   0x08
  39          #define EW_YEL   0x10
  40          #define EW_GRN   0x20
  41          
  42          typedef enum
  43          {
  44              NS_GREEN = 0,
  45              NS_YELLOW,
  46              EW_GREEN,
  47              EW_YELLOW
  48          } traffic_state_t;
  49          
  50          /* tick_50ms: incremented by Timer0 ISR every 50 ms */
  51          volatile unsigned int tick_50ms = 0;
  52          
  53          /* remain_seconds: how many software-seconds remain in the current state */
  54          volatile unsigned char remain_seconds = 8;
C51 COMPILER V9.54   EX2_TRAFFIC_EMERGENCY                                                 04/17/2026 05:15:51 PAGE 2   

  55          
  56          /* state: current traffic light state, initialized to NS green */
  57          volatile traffic_state_t state = NS_GREEN;
  58          
  59          /* second_flag: set by Timer0 ISR when 1 s has elapsed */
  60          volatile bit second_flag = 0;
  61          
  62          /* emergency_req: set by INT0 ISR when an emergency vehicle is detected */
  63          volatile bit emergency_req = 0;
  64          
  65          /* emergency_active: true while the all-red protection phase is running */
  66          volatile bit emergency_active = 0;
  67          
  68          /* saved state and remaining time before emergency, restored afterwards */
  69          volatile unsigned char saved_remain = 0;
  70          volatile traffic_state_t saved_state = NS_GREEN;
  71          
  72          /*
  73           * show_state() - translate abstract state to P1 port output.
  74           * Wiring changes only require editing this function.
  75           */
  76          void show_state(traffic_state_t s)
  77          {
  78   1          switch (s)
  79   1          {
  80   2          case NS_GREEN:
  81   2              P1 = NS_GRN | EW_RED;
  82   2              break;
  83   2          case NS_YELLOW:
  84   2              P1 = NS_YEL | EW_RED;
  85   2              break;
  86   2          case EW_GREEN:
  87   2              P1 = NS_RED | EW_GRN;
  88   2              break;
  89   2          case EW_YELLOW:
  90   2              P1 = NS_RED | EW_YEL;
  91   2              break;
  92   2          default:
  93   2              P1 = 0x00;
  94   2              break;
  95   2          }
  96   1      }
  97          
  98          /* all_red() - both directions stopped; used during emergency phase */
  99          void all_red(void)
 100          {
 101   1          P1 = NS_RED | EW_RED;
 102   1      }
