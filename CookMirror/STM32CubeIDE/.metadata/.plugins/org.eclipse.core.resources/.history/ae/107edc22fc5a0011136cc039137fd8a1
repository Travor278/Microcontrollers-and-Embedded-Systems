#include <stdint.h>

#define RCC_APB2ENR  (*(volatile uint32_t *)0x40021018U)

#define GPIOC_CRH    (*(volatile uint32_t *)0x40011004U)
#define GPIOC_BSRR   (*(volatile uint32_t *)0x40011010U)
#define GPIOC_BRR    (*(volatile uint32_t *)0x40011014U)

#define SYST_CSR     (*(volatile uint32_t *)0xE000E010U)
#define SYST_RVR     (*(volatile uint32_t *)0xE000E014U)
#define SYST_CVR     (*(volatile uint32_t *)0xE000E018U)

#define RCC_IOPCEN   (1U << 4)
#define LED_PIN      13U
#define SYSCLK_HZ    8000000U

static void systick_init(void)
{
    SYST_RVR = (SYSCLK_HZ / 1000U) - 1U;
    SYST_CVR = 0U;
    SYST_CSR = (1U << 2) | (1U << 0);
}

static void delay_ms(uint32_t ms)
{
    while (ms--) {
        while ((SYST_CSR & (1U << 16)) == 0U) {
        }
    }
}

void SystemInit(void)
{
}

int main(void)
{
    RCC_APB2ENR |= RCC_IOPCEN;

    GPIOC_CRH &= ~(0xFU << 20);
    GPIOC_CRH |=  (0x2U << 20);
    systick_init();

    while (1) {
        GPIOC_BSRR = (1U << LED_PIN);
        delay_ms(50U);

        GPIOC_BRR = (1U << LED_PIN);
        delay_ms(50U);
    }
}
